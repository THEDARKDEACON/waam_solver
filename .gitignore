# VTK, LBM, HARDWARE, weld_pool_physics). These drafts go stale — untrack with:
#   git rm --cached <path>
docs/WAAM_TWIN_V2_EXECUTION_PLAN.md
docs/FEM_LECTURE_SLIDES_ANALYSIS.md
docs/BEAD_GEOMETRY_PHYSICS_SPEC.md
docs/DIAGNOSTICS_AND_VTK_SPEC.md
