{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WAAM twin job file",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string"
    },
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "physics_tier": {
          "type": "string",
          "enum": [
            "thermal",
            "flow",
            "full",
            "base",
            "default",
            "standard_physics"
          ]
        },
        "domain_mm": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "dx_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "auto_grid": {
          "type": "boolean",
          "description": "Accepted for compatibility. dx_mm is allocated as requested; the device OOMs if the mesh does not fit. Cell count scales as 1/dx^3."
        },
        "strict_mode": {
          "type": "boolean"
        },
        "enable_vof": {
          "type": "boolean"
        },
        "enable_csf_tension": {
          "type": "boolean"
        },
        "enable_wetting": {
          "type": "boolean"
        },
        "enable_hydrostatic_gravity": {
          "type": "boolean"
        },
        "enable_bead_freeze": {
          "type": "boolean"
        },
        "enable_trailing_solidify": {
          "type": "boolean"
        },
        "periodic_x": {
          "type": "boolean"
        },
        "use_free_surface_lbm": {
          "type": "boolean"
        },
        "energy_split": {
          "type": "boolean",
          "description": "Arc heat = eta*V*I minus the (running-mean) droplet enthalpy power, so arc + droplets = eta*V*I. Off: the arc injects eta*V*I and droplets add their enthalpy on top."
        },
        "sparse_grid": {
          "type": "boolean",
          "description": "Store and compute only 8^3-cell blocks near metal (FSLBM or thermal tier); default false"
        },
        "sparse_halo_blocks": {
          "type": "integer",
          "minimum": 1,
          "description": "Blocks kept around metal on a sparse grid (default 1 = 8 cells)"
        },
        "sparse_refresh_every": {
          "type": "integer",
          "minimum": 1,
          "description": "Steps between sparse active-set refreshes (default 16)"
        },
        "surface_query_every": {
          "type": "integer",
          "minimum": 1,
          "description": "Re-read the arc-column surface height every N steps (GPU sync); 1 = every step (default 8)"
        },
        "fs_contact_slip": {
          "type": "boolean",
          "description": "FSLBM: specular slip on wall links at the contact line (default true)"
        },
        "C_darcy_phys": {
          "type": "number"
        },
        "dt_mode": {
          "type": "string"
        },
        "ma_max": {
          "type": "number"
        },
        "force_limit_m_s2": {
          "type": "number",
          "minimum": 0,
          "description": "Physical body-force acceleration cap [m/s\u00b2]. When >0, F_lu=a\u00b7dt\u00b2/dx each step (mesh-invariant Phase 3 path)."
        },
        "enable_droplet_impact_pressure": {
          "type": "boolean"
        },
        "enable_recoil": {
          "type": "boolean"
        },
        "use_recoil_clausius_clapeyron": {
          "type": "boolean"
        },
        "enable_lorentz": {
          "type": "boolean"
        },
        "enable_gas_shear": {
          "type": "boolean"
        },
        "enable_enthalpy_cap": {
          "type": "boolean"
        },
        "enable_evaporative_cooling": {
          "type": "boolean"
        },
        "arc_surface_weighting": {
          "type": "boolean"
        },
        "enable_substrate_growth": {
          "type": "boolean"
        },
        "enable_ctwd": {
          "type": "boolean"
        },
        "enable_marangoni": {
          "type": "boolean"
        },
        "enable_buoyancy": {
          "type": "boolean"
        },
        "enable_arc_pressure": {
          "type": "boolean"
        },
        "enable_deposition_momentum": {
          "type": "boolean"
        },
        "use_torch_z": {
          "type": "boolean"
        },
        "enable_torch_z": {
          "type": "boolean"
        },
        "enable_moving_window": {
          "type": "boolean",
          "description": "Slide the local mesh with the torch in +X, \u00b1Y, and \u00b1Z (Z only when use_torch_z is set). New strips are filled with ambient plate/gas."
        },
        "enable_alloy_mixing": {
          "type": "boolean",
          "description": "Diffuse alloy_frac among neighbouring liquid cells in the fusion zone. Default false \u2014 birth composition is unchanged. Dual-alloy jobs only."
        },
        "alloy_mix_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Jacobi mix rate per step when enable_alloy_mixing is true (default 0.25)."
        },
        "dt_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Optional multiplier on WAAMGrid.dt (default 1.0). \u03c4>0.5 and \u03b1_lu\u22641/6 guards still apply. Values <1 reduce thermal\u2013flow operator-splitting lag."
        },
        "welding_position": {"enum": ["flat", "overhead", "vertical_down", "vertical_up"], "description": "Gravity direction relative to the plate: flat (-z), overhead (+z, plate above the bead), vertical_down/up (along/against the travel direction)."},
        "gravity_direction": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3, "description": "Explicit gravity vector in grid axes (+z away from the plate face); overrides welding_position."},
        "smagorinsky_cs": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.3,
          "description": "Smagorinsky constant for the LBM subgrid eddy viscosity (0 = off). The eddy viscosity scales with dx^2 and fades on finer meshes, so the constant is not mesh-tuned; 0.1-0.17 is the usual range."
        },
        "lbm_gas_band": {
          "type": "integer",
          "minimum": 0,
          "description": "Stream LBM populations in gas only within this many cells of metal (0 = all gas, the default). Far gas never collides and only feeds the interface through the band edge; 4 keeps the full-domain result while skipping most gas on coupon jobs."
        },
        "thermal_dt": {
          "oneOf": [
            {"type": "string", "enum": ["auto", "lbm"]},
            {"type": "number", "exclusiveMinimum": 0}
          ],
          "description": "physics_tier thermal without wire feed: 'auto' (default) steps at 0.8 of the explicit conduction limit dx\u00b2/(6\u03b1_max) and skips LBM/VOF/forces; a number is dt in seconds (must be under the limit); 'lbm' keeps the Mach-scaled dt and the full coupled step. Ignored when dt_scale is set."
        },
        "warn_on_force_clamp": {
          "type": "boolean",
          "description": "Log a warning when the body-force clamp fires. Default false. strict_mode abort is unchanged."
        },
        "use_variable_tau": {
          "type": "boolean",
          "description": "Per-cell \u03c4 from \u03bc(T) tables. With use_srt false \u2192 two-rate MRT variable-\u03c4; with use_srt true \u2192 SRT variable-\u03c4."
        },
        "use_srt": {
          "type": "boolean",
          "description": "Override preset collision. false \u2192 two-rate central-moment MRT (constant or variable \u03c4)."
        },
        "auto_dt_ma": {
          "type": "boolean",
          "description": "Shrink dt so u_design_m_s*dt/dx \u2264 u_mach_limit_lu and \u03c4\u22650.505."
        },
        "u_design_m_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Design peak physical velocity [m/s] for auto_dt_ma (default 0.5)."
        },
        "contact_slip_band_mm": {
          "type": "number",
          "minimum": 0,
          "description": "Physical width [mm] of the free-surface contact-line slip band (0 = legacy one-cell pair)."
        },
        "tau_min": {
          "type": "number",
          "exclusiveMinimum": 0.5,
          "description": "Relaxation-time floor for auto_dt_ma (default 0.5005 TRT, 0.505 SRT)."
        },
        "pool_metric": {
          "type": "string",
          "enum": [
            "fusion_zone",
            "fl_bbox"
          ],
          "description": "Primary pool W/D metric (prefer claim.pool_metric)."
        },
        "u_mach_limit_lu": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Lattice-velocity Mach clamp (default 0.08). strict_mode aborts on sustained hits."
        },
        "force_limit_lu": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Body-force magnitude clamp in lattice units (default 0.05). Used when force_limit_m_s2 is unset/0."
        },
        "C_darcy": {
          "type": "number",
          "minimum": 0,
          "description": "Carman\u2013Kozeny lattice constant at C_darcy_ref_dt_s (default 1.6e5). Kernels use C_eff=C\u00b7(dt/dt_ref)."
        },
        "C_darcy_ref_dt_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Reference timestep [s] at which job C_darcy was defined. Effective C scales as dt/dt_ref."
        },
        "plate_thickness_mm": {
          "type": "number"
        },
        "plate_size_mm": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "plate_origin_mm": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "plate_length_mm": {
          "type": "number"
        },
        "plate_width_mm": {
          "type": "number"
        },
        "substrate_thickness_mm": {
          "type": "number"
        },
        "domain_margin_mm": {
          "type": "number"
        },
        "air_gap_mm": {
          "type": "number"
        }
      }
    },
    "plate": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "thickness_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "size_mm": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "origin_mm": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "material": {
          "type": [
            "string",
            "object"
          ]
        }
      }
    },
    "material": {
      "type": [
        "string",
        "object"
      ]
    },
    "calibration": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "frame": {
      "type": "string"
    },
    "torch_path_csv": {
      "type": "string"
    },
    "torch_path": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x_mm": {
            "type": "number"
          },
          "y_mm": {
            "type": "number"
          },
          "z_mm": {
            "type": "number"
          }
        }
      }
    },
    "heat_source": {
      "type": "string",
      "enum": [
        "gaussian2d",
        "gaussian",
        "gauss",
        "surface",
        "surfacegaussian",
        "surfaceflux",
        "goldak",
        "goldak3d",
        "doubleellipsoid"
      ]
    },
    "goldak": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ff": {
          "type": "number"
        },
        "fr": {
          "type": "number"
        },
        "a_front_mm": {
          "type": "number"
        },
        "a_rear_mm": {
          "type": "number"
        },
        "b_mm": {
          "type": "number"
        },
        "c_mm": {
          "type": "number"
        },
        "depth_front_mm": {
          "type": "number"
        },
        "depth_rear_mm": {
          "type": "number"
        },
        "sigma_scale": {
          "type": "number"
        },
        "normalize_energy": {
          "type": "boolean"
        }
      }
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "current_A": {
          "type": "number"
        },
        "voltage_V": {
          "type": "number"
        },
        "arc_efficiency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "travel_speed_mm_s": {
          "type": "number"
        },
        "wire_feed_m_min": {
          "type": "number"
        },
        "wire_diameter_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "droplet_length_mm": {
          "type": "number"
        },
        "T_ambient_K": {
          "type": "number"
        },
        "stickout_mm": {
          "type": "number"
        },
        "ctwd_mm": {
          "type": "number"
        },
        "transfer_mode": {
          "type": "string"
        },
        "droplet_transfer_mode": {
          "type": "string"
        },
        "droplet_size_jitter": {
          "type": "number"
        },
        "impact_lead_angle_deg": {
          "type": "number"
        },
        "droplet_freq_hz": {
          "type": "number"
        },
        "mean_power_W": {"type": "number", "minimum": 0, "description": "Measured mean electrical power mean(U*I) [W] (e.g. digitised waveform); replaces V*I and the pulse-train estimate. Heat input = arc_efficiency * mean_power_W."},
        "current_rms_A": {"type": "number", "minimum": 0, "description": "Measured rms current [A]; replaces the rectangular pulse-train rms for arc pressure, J x B and stick-out heating."},
        "pulse_peak_A": {"type": "number", "minimum": 0, "description": "Pulsed GMAW peak current; with pulse_base_A, pulse_peak_ms and pulse_frequency_hz gives I_mean and I_rms (I_rms drives arc pressure, J x B and stick-out heating)."},
        "pulse_base_A": {"type": "number", "minimum": 0},
        "pulse_peak_ms": {"type": "number", "exclusiveMinimum": 0},
        "droplet_impact_speed_m_s": {"type": "number", "exclusiveMinimum": 0, "description": "Measured droplet impact speed (e.g. high-speed video); replaces the feed/free-fall/pinch estimate."},
        "arc_slope_ohm": {"type": "number", "minimum": 0, "description": "Pulsed GMAW arc voltage slope R in U = U0 + R*I (default 0.05, IEC 60974-1 MIG/MAG load line); mean power = V*I_mean + R*(I_rms^2 - I_mean^2)."},
        "pulse_frequency_hz": {
          "type": "number"
        },
        "power_factor": {
          "type": "number"
        },
        "duty_cycle": {
          "type": "number"
        },
        "arc_sigma_mm": {
          "type": "number"
        }
      }
    },
    "arc_physics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sigma_mm": {
          "type": "number"
        },
        "penetration_mm": {
          "type": "number"
        },
        "T_vapor_cap_K": {
          "type": "number"
        },
        "surface_weighting": {
          "type": "boolean"
        },
        "heat_anchor": {"enum": ["surface", "torch"], "description": "Where the arc heat source sits: surface = top metal under the torch; torch = fixed to the torch (plate face / layer height), the conventional Goldak frame."},
        "pressure_model": {
          "type": "string"
        },
        "pressure_pa": {
          "type": "number"
        },
        "pressure_sigma_mm": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "advanced_physics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gas_jet_velocity_m_s": {
          "type": "number"
        },
        "gas_shear_coeff": {
          "type": "number"
        },
        "sigma_liquid_Sm": {
          "type": "number"
        },
        "sigma_solid_Sm": {
          "type": "number"
        },
        "sigma_gas_Sm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Lorentz potential: gas is grounded through this leakage conductivity (default 1 S/m). Keeps metal cut off from the plate well-posed."
        },
        "lorentz_jacobi_iters": {
          "type": "integer"
        },
        "lorentz_solve_every_s": {
          "type": "number",
          "minimum": 0
        },
        "lorentz_jacobi_cold_iters": {
          "type": "integer"
        },
        "lorentz_jacobi_tol": {
          "type": "number"
        },
        "T_boiling_K": {
          "type": "number"
        },
        "T_recoil_onset_K": {
          "type": "number"
        },
        "L_vapor_J_kg": {
          "type": "number"
        },
        "R_spec_vapor_J_kgK": {
          "type": "number"
        },
        "recoil_accommodation": {
          "type": "number"
        },
        "evap_cooling_scale": {
          "type": "number"
        },
        "bulk_tau": {
          "type": "number",
          "minimum": 0,
          "description": "TRT odd-mode relaxation time tau_odd (omega_o = 1/bulk_tau), constant- and variable-tau collision alike. Default 1.0. 0 selects the magic Lambda = 1/4 (tau_odd ~300 at liquid-metal tau ~0.5008; unstable under mushy-zone drag at 150-200 A)."
        },
        "marangoni_scale": {
          "type": "number",
          "description": "Multiplier on material d\u03b3/dT (default 1.0). Prefer material surfactant model over this knob."
        },
        "C_darcy": {
          "type": "number",
          "minimum": 0,
          "description": "Alias for simulation.C_darcy (Carman\u2013Kozeny)."
        },
        "C_darcy_ref_dt_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Alias for simulation.C_darcy_ref_dt_s."
        },
        "u_mach_limit_lu": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Alias for simulation.u_mach_limit_lu."
        },
        "force_limit_lu": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Alias for simulation.force_limit_lu."
        },
        "force_limit_m_s2": {
          "type": "number",
          "minimum": 0,
          "description": "Alias for simulation.force_limit_m_s2."
        },
        "use_variable_tau": {
          "type": "boolean",
          "description": "Alias for simulation.use_variable_tau."
        },
        "use_srt": {
          "type": "boolean",
          "description": "Alias for simulation.use_srt."
        }
      }
    },
    "deposition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "superheat_K": {
          "type": "number"
        },
        "footprint_sigma_scale": {
          "type": "number"
        },
        "trailing_solidify_lookback_mm": {
          "type": "number"
        },
        "trailing_solidify_temp_margin_K": {
          "type": "number"
        },
        "max_footprint_mm": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "surface_wetting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contact_angle_deg": {
          "type": "number"
        }
      }
    },
    "heat_loss": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "convection": {
          "type": "boolean"
        },
        "radiation": {
          "type": "boolean"
        },
        "h_conv": {
          "type": "number"
        },
        "eps_rad": {
          "type": "number"
        }
      }
    },
    "interpass": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cooling_steps": {
          "type": "integer"
        },
        "travel_speed_mm_s": {
          "type": "number"
        }
      }
    },
    "electrical": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rho_e_ohm_m": {
          "type": "number"
        },
        "eta_stick": {
          "type": "number"
        }
      }
    },
    "layer_height_mm": {
      "type": "number"
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mesh_tier": {
          "type": "string",
          "enum": [
            "shop",
            "hpc"
          ]
        },
        "absolute_wd": {
          "type": "boolean"
        },
        "trend_only": {
          "type": "boolean"
        },
        "tier_label": {
          "type": "string"
        },
        "pool_metric": {
          "type": "string",
          "enum": [
            "fusion_zone",
            "fl_bbox"
          ]
        },
        "characterisation": {
          "type": "string"
        },
        "accuracy": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "knobs_fitted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "knobs_predicted": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "knobs_locked": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Must match calibrate lock on held-outs (not free process knobs)."
        },
        "known_defects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Documented solver/claim defects; shrink as fixes land."
        },
        "operating_regime": {
          "type": "string",
          "description": "\u03c4/Ma/clamp honesty for the lock mesh."
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": true
    },
    "model_reference": {
      "type": "object",
      "additionalProperties": true
    },
    "probes": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "Legacy list of probe points (default z_ref=plate_bottom)."
        },
        {
          "type": "object",
          "required": [
            "points"
          ],
          "additionalProperties": false,
          "properties": {
            "z_ref": {
              "type": "string",
              "enum": [
                "plate_bottom",
                "plate_face",
                "world",
                "bottom",
                "face",
                "domain"
              ],
              "description": "Section default for converting z_mm to domain world."
            },
            "points": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "probes": {
              "type": "array",
              "items": {
                "type": "object"
              },
              "description": "Alias for points."
            },
            "sample_every_ms": {
              "type": "number",
              "minimum": 0,
              "description": "Record every N ms of simulated time (default 1; 0 = every step)."
            }
          }
        }
      ]
    }
  }
}
